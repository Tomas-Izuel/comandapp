# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Bypassea RLS: jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Origen del APEX, siempre — nunca el de una tienda. `src/lib/urls.ts` deriva
# de acá tanto el link del panel como el subdominio de cada local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cómo se sirve la vitrina de una tienda: `path` (`<apex>/<slug>`, como hoy) o
# `subdomain` (`<slug>.<apex>`). SOLO se setea en Production, una vez que el
# dominio wildcard de comandapp.ar esté con el DNS en Vercel. En local y en
# Preview no se toca: sin esta variable el default es `path` y nada cambia.
NEXT_PUBLIC_STORE_HOST_MODE=path

# ---------------------------------------------------------------------------
# WhatsApp — 'link' genera un wa.me que el local toca; 'cloud' envía solo.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=link
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_TEMPLATE=pedido_listo

# ---------------------------------------------------------------------------
# Cron del outbox hacia el POS del local
# ---------------------------------------------------------------------------
CRON_SECRET=

# Kill-switch del rate limiting. Vacío o `true` = prendido. Poner `false` solo
# para apagarlo de urgencia si una calibración está cortando ventas reales.
RATE_LIMIT_ENABLED=

# ---------------------------------------------------------------------------
# Resend — mails de auth (magic link) y, si el cliente deja su email,
# comprobante y aviso de "pedido listo".
#
# RESEND_FROM_EMAIL tiene que estar en un dominio VERIFICADO en Resend. Con el
# dominio sin verificar, Resend solo entrega a la dirección de tu cuenta.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Tu casilla real, para los usuarios que crea el bootstrap de desarrollo.
# Con Resend conectado las direcciones inventadas no se entregan; de acá se
# derivan vos+admin@... y vos+dueno-la-birra@... con plus-addressing.
DEV_EMAIL=

# ---------------------------------------------------------------------------
# "Continuar con Google" — backoffice de plataforma
#
# El client ID y el secret salen de Google Cloud Console (OAuth client de tipo
# "Web application"). El authorized redirect URI que hay que cargar ahí es el
# callback del PROYECTO DE SUPABASE (no el de esta app):
#
#   https://<tu-proyecto>.supabase.co/auth/v1/callback
#   http://127.0.0.1:54321/auth/v1/callback   (local, con el stack levantado)
#
# Esta app nunca ve el secret: lo usa Supabase Auth directo. Se necesitan las
# DOS variables igual en `.env` (las lee el CLI de Supabase para sustituir el
# `env(...)` de `supabase/config.toml`) y el CLIENT_ID también en `.env.local`
# (lo lee Next, solo para decidir si mostrar el botón). Ver la trampa de
# `env(...)` en CLAUDE.md: son archivos distintos, no se comparten solos.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Dirección de Google con la que entrás al backoffice. La siembra el bootstrap
# en `public.signup_allowlist`, y sin esa fila el primer ingreso con Google
# rebota con 403 (el hook `before_user_created` rechaza todo lo que no esté).
#
# Solo hace falta si NO es la misma que DEV_EMAIL. El default deriva de ahí,
# pero sin el plus-addressing: `devAddress('admin')` arma `vos+admin@…` para
# que el mail llegue a una casilla que puedas abrir, y Google en cambio siempre
# devuelve la dirección canónica. Sembrar la versión con `+admin` no matchea
# nunca y el síntoma es un 403 que no dice por qué.
PLATFORM_ADMIN_GOOGLE_EMAIL=

# ---------------------------------------------------------------------------
# Cifrado de credenciales de cobro
#
# Clave AES-256 en base64 (32 bytes) con la que se cifran el access token y el
# webhook secret de Mercado Pago de cada tienda en store_payment_credentials.
# Sin esta clave no se pueden guardar credenciales nuevas (a propósito).
#
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Validación de titular de cuenta bancaria (transferencia)
#
# 'manual' (default) es el no-op: sin esta variable, el sistema funciona
# entero — checksum de CBU/CVU + declaración del dueño + código de 6 dígitos.
# 'certisend' está escrito contra el contrato pero NO VIABLE hoy (investigado:
# sin sandbox, sin precio publicado, sin SLA — ver
# docs/pipelines/2026-08-30-transferencia-bancaria/00-architecture.md §3.4).
# No lo actives sin un contrato firmado con Sysworld/Certisend.
# ---------------------------------------------------------------------------
BANK_VALIDATION_PROVIDER=manual
CERTISEND_API_URL=
CERTISEND_TOKEN_SUSC=
CERTISEND_TOKEN_API=
