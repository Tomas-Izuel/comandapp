{
  "name": "burger-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "./scripts/db-reset.sh",
    "db:bootstrap": "node --env-file=.env.local scripts/bootstrap-dev.mjs",
    "db:types": "npx supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "resend:setup": "node --env-file=.env.local scripts/resend-setup.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "mercadopago": "^3.4.0",
    "next": "16.3.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "resend": "^6.24.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "shadcn": "^4.19.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
